      document.getElementById('message-modal').classList.remove('hidden');
    }
    function closeModal() {
      document.getElementById('message-modal').classList.add('hidden');
    }

    function initMatchingCards() {
      const palette = document.getElementById('cards-palette');
      palette.innerHTML = '';

      const shuffled = [...organData].sort(() => Math.random() - 0.5);

      shuffled.forEach(organ => {
        const card = document.createElement('div');
        card.id = `card-organ-${organ.id}`;
        card.dataset.organId = organ.id;
        card.draggable = true;
        card.className = "draggable-card bg-white border-2 border-sky-300 text-sky-900 font-bold px-3 py-2.5 rounded-xl text-xs sm:text-sm shadow-sm flex items-center justify-between select-none hover:border-sky-500";
        
        card.innerHTML = `
          <span>${organ.name}</span>
          <span class="text-sky-400 text-xs">⠿</span>
        `;

        card.addEventListener('click', () => handleCardTap(organ.id));

        card.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', organ.id);
          highlightCardSelection(organ.id);
        });

        palette.appendChild(card);
      });

      document.querySelectorAll('.drop-zone').forEach(zone => {
        const zoneId = parseInt(zone.dataset.organId);

        zone.addEventListener('click', () => handleZoneTap(zoneId));

        zone.addEventListener('dragover', (e) => {
          e.preventDefault();
          zone.classList.add('hovered');
        });

        zone.addEventListener('dragleave', () => {
          zone.classList.remove('hovered');
        });

        zone.addEventListener('drop', (e) => {
          e.preventDefault();
          zone.classList.remove('hovered');
          const organId = parseInt(e.dataTransfer.getData('text/plain'));
          if (organId) {
            assignCardToZone(organId, zoneId);
          }
        });
      });
    }

    function highlightCardSelection(organId) {
      selectedCardId = organId;
      document.querySelectorAll('.draggable-card').forEach(c => {
        if (parseInt(c.dataset.organId) === organId) {
          c.classList.add('selected');
        } else {
          c.classList.remove('selected');
        }
      });
    }

    function clearCardSelection() {
      selectedCardId = null;
      document.querySelectorAll('.draggable-card').forEach(c => c.classList.remove('selected'));
    }

    function handleCardTap(organId) {
      if (selectedCardId === organId) {
        clearCardSelection();
      } else {
        highlightCardSelection(organId);
      }
    }

    function handleZoneTap(zoneId) {
      if (selectedCardId !== null) {
        assignCardToZone(selectedCardId, zoneId);
        clearCardSelection();
      } else if (matchingUserAnswers[zoneId]) {
        returnCardToPalette(matchingUserAnswers[zoneId]);
      }
    }

    function assignCardToZone(organId, zoneId) {
      Object.keys(matchingUserAnswers).forEach(zId => {
        if (matchingUserAnswers[zId] === organId) {
          delete matchingUserAnswers[zId];
          resetZoneVisual(parseInt(zId));
        }
      });

      matchingUserAnswers[zoneId] = organId;

      const zone = document.querySelector(`.drop-zone[data-organ-id="${zoneId}"]`);
      const organObj = organData.find(o => o.id === organId);
      
      zone.classList.add('filled');
      zone.innerHTML = `
        <div class="flex items-center justify-between w-full px-2 py-1 bg-sky-100 text-sky-900 font-bold rounded-lg text-xs">
          <span class="truncate">${organObj.name}</span>
          <button onclick="event.stopPropagation(); returnCardToPalette(${organId})" class="text-red-500 font-bold ml-1 hover:text-red-700">✕</button>
        </div>
      `;

      const cardEl = document.getElementById(`card-organ-${organId}`);
      if (cardEl) cardEl.classList.add('hidden');

      if (matchingChecked) {
        hideMatchingFeedback();
      }
    }

    function returnCardToPalette(organId) {
      Object.keys(matchingUserAnswers).forEach(zId => {
        if (matchingUserAnswers[zId] === organId) {
          delete matchingUserAnswers[zId];
          resetZoneVisual(parseInt(zId));
        }
      });

      const cardEl = document.getElementById(`card-organ-${organId}`);
      if (cardEl) cardEl.classList.remove('hidden');

      clearCardSelection();
      if (matchingChecked) {
        hideMatchingFeedback();
      }
    }

    function resetZoneVisual(zoneId) {
      const zone = document.querySelector(`.drop-zone[data-organ-id="${zoneId}"]`);
      zone.classList.remove('filled', 'border-emerald-500', 'border-red-500', 'bg-emerald-50', 'bg-red-50');
      zone.className = "drop-zone absolute w-[38%] h-[8.5%] border-2 border-dashed border-slate-400 bg-white/95 rounded-xl flex items-center justify-center text-xs font-bold text-slate-600 shadow-sm cursor-pointer hover:border-blue-600";
      
      // Maintain proper positioning per zone
      const topPositions = {
        1: "top-[5.5%] right-[2%]",
        2: "top-[23%] left-[2%]",
        3: "top-[41.5%] right-[2%]",
        4: "top-[45%] left-[2%]",
        5: "top-[59%] left-[2%]",
        6: "top-[61.5%] right-[2%]",
        7: "top-[75.5%] left-[2%]"
      };
      
      zone.className += ` ${topPositions[zoneId]}`;
      zone.innerHTML = `<span class="placeholder-text">Petak ${zoneId}</span>`;
    }

    function renderDualFeedbackPanels(scoreCount) {
      const topPanel = document.getElementById('matching-feedback-top');
      const bottomPanel = document.getElementById('matching-feedback-bottom');
      const btnNext = document.getElementById('btn-next-screen4');

      let htmlContent = '';
      let bgClasses = '';

      if (scoreCount === 7) {
        bgClasses = 'bg-emerald-100 border-emerald-300 text-emerald-900';
        htmlContent = `
          <div class="flex flex-col sm:flex-row items-center justify-center gap-2">
            <span class="text-2xl">🎉</span>
            <div>
              <p class="font-extrabold text-base sm:text-lg">🎉 TAHNIAH! ANDA BERJAYA MEMADANKAN SEMUA 7 ORGAN DENGAN BETUL! 🏆</p>
              <p class="text-xs sm:text-sm font-semibold">Markah: <b>7/7</b> (7 Padanan Betul) • Status: <b>SEMPURNA!</b></p>
            </div>
          </div>
        `;
      } else if (scoreCount >= 4) {
        bgClasses = 'bg-sky-100 border-sky-300 text-sky-900';
        htmlContent = `
          <div class="flex flex-col sm:flex-row items-center justify-center gap-2">
            <span class="text-xl">👍</span>
            <div>
              <p class="font-bold text-base">Syabas! Markah anda: <b>${scoreCount}/7</b> (${scoreCount} Padanan Betul)</p>
              <p class="text-xs sm:text-sm">Anda telah mencapai sasaran minimum (≥4/7)! Boleh tekan 'Seterusnya' atau baiki jawapan untuk markah penuh (7/7).</p>
            </div>
          </div>
        `;
      } else {
        bgClasses = 'bg-amber-100 border-amber-300 text-amber-900';
        htmlContent = `
          <div class="flex flex-col sm:flex-row items-center justify-center gap-2">
            <span class="text-xl">💪</span>
            <div>
              <p class="font-bold text-base">Cuba Lagi! Markah anda: <b>${scoreCount}/7</b> (${scoreCount} Padanan Betul)</p>
              <p class="text-xs sm:text-sm">Padankan sekurang-kurangnya 4 organ dengan betul untuk membuka misi seterusnya.</p>
            </div>
          </div>
        `;
      }

      [topPanel, bottomPanel].forEach(panel => {
        panel.className = `p-4 rounded-2xl text-center shadow-md transition border ${bgClasses}`;
        panel.innerHTML = htmlContent;
        panel.classList.remove('hidden');
      });

      if (scoreCount >= 4) {
        btnNext.classList.remove('hidden');
        btnNext.classList.add('inline-flex');
      } else {
        btnNext.classList.add('hidden');
        btnNext.classList.remove('inline-flex');
      }
    }

    function checkMatchingAnswers() {
      let correctCount = 0;
      
      organData.forEach(organ => {
        const zoneId = organ.id;
        const placedOrganId = matchingUserAnswers[zoneId];
        const zone = document.querySelector(`.drop-zone[data-organ-id="${zoneId}"]`);

        if (placedOrganId === organ.id) {
          correctCount++;
          if (zone) {
            zone.classList.remove('border-red-500', 'bg-red-50');
            zone.classList.add('border-emerald-500', 'bg-emerald-50');
          }
        } else if (placedOrganId !== undefined) {
          if (zone) {
            zone.classList.remove('border-emerald-500', 'bg-emerald-50');
            zone.classList.add('border-red-500', 'bg-red-50');
          }
        }
      });

      matchingScore = correctCount;
      matchingChecked = true;

      renderDualFeedbackPanels(correctCount);

      if (correctCount === 7 && !confettiFiredForAttempt) {
        triggerDualSideCannonConfetti();
        confettiFiredForAttempt = true;
      }
    }

    function hideMatchingFeedback() {
      matchingChecked = false;
      document.getElementById('matching-feedback-top').classList.add('hidden');
      document.getElementById('matching-feedback-bottom').classList.add('hidden');
    }

    function showMatchingAnswers() {
      organData.forEach(organ => {
        assignCardToZone(organ.id, organ.id);
      });
      checkMatchingAnswers();
    }

    function resetMatchingGame() {
      matchingUserAnswers = {};
      matchingScore = 0;
      matchingChecked = false;
      confettiFiredForAttempt = false;
      selectedCardId = null;

      document.querySelectorAll('.drop-zone').forEach(zone => {
        resetZoneVisual(parseInt(zone.dataset.organId));
      });

      document.querySelectorAll('.draggable-card').forEach(card => {
        card.classList.remove('hidden', 'selected');
      });

      hideMatchingFeedback();

      const btnNext = document.getElementById('btn-next-screen4');
      btnNext.classList.add('hidden');
      btnNext.classList.remove('inline-flex');
    }

    function triggerDualSideCannonConfetti() {
      const container = document.getElementById('confetti-container');
      container.innerHTML = '';

      const colors = ['#38BDF8', '#FBBF24', '#F472B6', '#34D399', '#A78BFA', '#FB923C', '#E11D48'];
      const piecesPerSide = 45;

      for (let i = 0; i < piecesPerSide; i++) {
        const confetti = document.createElement('div');
        confetti.className = 'confetti-piece animate-confetti-left';
        
        const sizeW = 8 + Math.random() * 8;
        const sizeH = 10 + Math.random() * 10;
        const color = colors[Math.floor(Math.random() * colors.length)];
        
        const dx = (25 + Math.random() * 40) + 'vw';
        const dy = (-40 - Math.random() * 45) + 'vh';
        const rot = (360 + Math.random() * 720) + 'deg';
        const delay = Math.random() * 0.3;
        const duration = 2.4 + Math.random() * 0.8;

        confetti.style.left = '0px';
        confetti.style.bottom = '10px';
        confetti.style.width = `${sizeW}px`;
        confetti.style.height = `${sizeH}px`;
        confetti.style.backgroundColor = color;
        confetti.style.borderRadius = Math.random() > 0.4 ? '3px' : '50%';
        confetti.style.setProperty('--dx', dx);
        confetti.style.setProperty('--dy', dy);
        confetti.style.setProperty('--rot', rot);
        confetti.style.animationDelay = `${delay}s`;
        confetti.style.animationDuration = `${duration}s`;

        container.appendChild(confetti);
      }

      for (let i = 0; i < piecesPerSide; i++) {
        const confetti = document.createElement('div');
        confetti.className = 'confetti-piece animate-confetti-right';
        
        const sizeW = 8 + Math.random() * 8;
        const sizeH = 10 + Math.random() * 10;
        const color = colors[Math.floor(Math.random() * colors.length)];
        
        const dx = (-25 - Math.random() * 40) + 'vw';
        const dy = (-40 - Math.random() * 45) + 'vh';
        const rot = (-360 - Math.random() * 720) + 'deg';
        const delay = Math.random() * 0.3;
        const duration = 2.4 + Math.random() * 0.8;

        confetti.style.right = '0px';
        confetti.style.bottom = '10px';
        confetti.style.width = `${sizeW}px`;
        confetti.style.height = `${sizeH}px`;
        confetti.style.backgroundColor = color;
        confetti.style.borderRadius = Math.random() > 0.4 ? '3px' : '50%';
        confetti.style.setProperty('--dx', dx);
        confetti.style.setProperty('--dy', dy);
        confetti.style.setProperty('--rot', rot);
        confetti.style.animationDelay = `${delay}s`;
        confetti.style.animationDuration = `${duration}s`;

        container.appendChild(confetti);
      }

      setTimeout(() => {
        container.innerHTML = '';
      }, 4200);
    }

    function selectQuizOption(qNum, optChar) {
      if (quizCheckedStatus[qNum]) return;

      quizUserAnswers[qNum] = optChar;

      const qBlock = document.getElementById(`quiz-q${qNum}`);
      const labels = qBlock.querySelectorAll('.quiz-opt-btn');

      labels.forEach(lbl => {
        const txt = lbl.innerText.trim();
        if (txt.startsWith(optChar)) {
          lbl.classList.add('border-sky-500', 'bg-sky-50', 'text-sky-900', 'font-bold');
        } else {
          lbl.classList.remove('border-sky-500', 'bg-sky-50', 'text-sky-900', 'font-bold');
        }
      });
    }

    function checkQuizAnswer() {
      const qNum = quizCurrentIdx;
      const userAns = quizUserAnswers[qNum];
      const feedbackBox = document.getElementById('quiz-feedback');
      const qData = quizData.find(q => q.id === qNum);

      if (!userAns) {
        showCustomModal("Perhatian", "Sila pilih satu jawapan sebelum menyemak!");
        return;
      }

      quizCheckedStatus[qNum] = true;
      feedbackBox.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-900', 'bg-rose-100', 'text-rose-900');

      const qBlock = document.getElementById(`quiz-q${qNum}`);
      const labels = qBlock.querySelectorAll('.quiz-opt-btn');

      labels.forEach(lbl => {
        const txt = lbl.innerText.trim();
        if (txt.startsWith(qData.correct)) {
          lbl.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');
        } else if (txt.startsWith(userAns) && userAns !== qData.correct) {
          lbl.classList.add('bg-rose-100', 'border-rose-500', 'text-rose-900');
        }
      });

      if (userAns === qData.correct) {
        feedbackBox.classList.add('bg-emerald-100', 'text-emerald-900');
        feedbackBox.innerHTML = `✅ <b>Tahniah, jawapan betul!</b><br>${qData.explain}`;
      } else {
        feedbackBox.classList.add('bg-rose-100', 'text-rose-900');
        feedbackBox.innerHTML = `❌ <b>Jawapan kurang tepat.</b><br>${qData.explain}`;
      }

      document.getElementById('btn-quiz-check').classList.add('hidden');
      if (qNum < 3) {
        document.getElementById('btn-quiz-next').classList.remove('hidden');
      } else {
        document.getElementById('btn-quiz-finish').classList.remove('hidden');
      }

      calculateQuizScore();
    }

    function calculateQuizScore() {
      let score = 0;
      quizData.forEach(q => {
        if (quizUserAnswers[q.id] === q.correct) {
          score++;
        }
      });
      quizScore = score;
    }

    function nextQuizQuestion() {
      if (quizCurrentIdx < 3) {
        document.getElementById(`quiz-q${quizCurrentIdx}`).classList.add('hidden');
        quizCurrentIdx++;
        document.getElementById(`quiz-q${quizCurrentIdx}`).classList.remove('hidden');
        
        document.getElementById('quiz-progress-text').innerText = `Soalan ${quizCurrentIdx} daripada 3`;
        document.getElementById('quiz-feedback').classList.add('hidden');
        
        document.getElementById('btn-quiz-check').classList.remove('hidden');
        document.getElementById('btn-quiz-next').classList.add('hidden');
      }
    }

    function resetQuiz() {
      quizCurrentIdx = 1;
      quizUserAnswers = {};
      quizCheckedStatus = { 1: false, 2: false, 3: false };
      quizScore = 0;

      for (let i = 1; i <= 3; i++) {
        const qBlock = document.getElementById(`quiz-q${i}`);
        if (qBlock) {
          if (i === 1) qBlock.classList.remove('hidden');
          else qBlock.classList.add('hidden');

          const labels = qBlock.querySelectorAll('.quiz-opt-btn');
          labels.forEach(lbl => {
            lbl.className = "quiz-opt-btn block p-4 rounded-xl border-2 border-slate-200 hover:border-sky-400 cursor-pointer transition font-medium text-sm";
          });
        }
      }

      document.getElementById('quiz-progress-text').innerText = `Soalan 1 daripada 3`;
      document.getElementById('quiz-feedback').classList.add('hidden');
      document.getElementById('btn-quiz-check').classList.remove('hidden');
      document.getElementById('btn-quiz-next').classList.add('hidden');
      document.getElementById('btn-quiz-finish').classList.add('hidden');
    }

    function updateFinalSummary() {
      calculateQuizScore();

      document.getElementById('final-score-matching').innerText = `${matchingScore}/7`;
      document.getElementById('final-score-quiz').innerText = `${quizScore}/3`;
      
      const totalScore = matchingScore + quizScore;
      document.getElementById('final-score-total').innerText = `${totalScore}/10`;

      const matchingStatusEl = document.getElementById('final-matching-status');
      if (matchingScore >= 4) {
        matchingStatusEl.innerText = "✓ Mencapai Sasaran";
        matchingStatusEl.className = "text-xs font-semibold block mt-1 text-emerald-600";
      } else {
        matchingStatusEl.innerText = "✗ Belum Mencapai";
        matchingStatusEl.className = "text-xs font-semibold block mt-1 text-rose-500";
      }

      const feedbackEl = document.getElementById('final-performance-feedback');
      if (totalScore >= 9) {
        feedbackEl.innerText = "🌟 Cemerlang! Anda sangat mahir mengenal organ pernafasan dan memahami fungsinya!";
      } else if (totalScore >= 7) {
        feedbackEl.innerText = "👏 Bagus sekali! Anda menunjukkan pemahaman yang baik tentang sistem pernafasan.";
      } else if (totalScore >= 5) {
        feedbackEl.innerText = "👍 Usaha yang baik! Teruskan mengulang kaji fungsi organ pernafasan.";
      } else {
        feedbackEl.innerText = "💪 Jangan putus asa! Cuba semula dan pelajari fungsi setiap organ dengan lebih teliti.";
      }
    }

    function resetAllGame() {
      resetMatchingGame();
      resetQuiz();
      showScreen(1);
    }

    window.addEventListener('DOMContentLoaded', () => {
      initMatchingCards();
    });
  </script>

</body>
</html>