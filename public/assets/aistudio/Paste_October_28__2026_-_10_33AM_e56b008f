      min-height: 100vh;
      overflow-x: hidden;
    }
    .font-fredoka { font-family: 'Fredoka', cursive, sans-serif; }
    
    /* Background Floating Animations */
    @keyframes floatBubble {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-15px) rotate(5deg); }
    }
    .animate-float {
      animation: floatBubble 5s ease-in-out infinite;
    }
    .animate-float-delayed {
      animation: floatBubble 6s ease-in-out 2s infinite;
    }

    /* Slow Gentle Breathing Animation for Cover Logo */
    @keyframes gentleBreathing {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }
    .animate-breathing {
      animation: gentleBreathing 4s ease-in-out infinite;
    }

    /* Screen Transition */
    .screen {
      display: none;
      animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .screen.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Drag & Drop Visual State */
    .draggable-card {
      cursor: grab;
      touch-action: manipulation;
      transition: all 0.2s ease;
    }
    .draggable-card:active {
      cursor: grabbing;
    }
    .draggable-card.selected {
      box-shadow: 0 0 0 4px #2563eb;
      transform: scale(1.04);
      background-color: #dbeafe !important;
    }
    .drop-zone {
      transition: all 0.2s ease;
    }
    .drop-zone.hovered {
      background-color: #fef08a !important;
      border-color: #ca8a04 !important;
      transform: scale(1.03);
    }
    .drop-zone.filled {
      border-style: solid;
      background-color: #ffffff;
    }

    /* Dual Side Cannon Confetti Styling */
    .confetti-piece {
      position: fixed;
      z-index: 9999;
      pointer-events: none;
      opacity: 0.95;
      will-change: transform, opacity;
    }

    @keyframes confettiCannonLeft {
      0% {
        transform: translate(0, 0) rotate(0deg) scale(1);
        opacity: 1;
      }
      70% {
        opacity: 1;
      }
      100% {
        transform: translate(var(--dx), var(--dy)) rotate(var(--rot)) scale(0.6);
        opacity: 0;
      }
    }

    @keyframes confettiCannonRight {
      0% {
        transform: translate(0, 0) rotate(0deg) scale(1);
        opacity: 1;
      }
      70% {
        opacity: 1;
      }
      100% {
        transform: translate(var(--dx), var(--dy)) rotate(var(--rot)) scale(0.6);
        opacity: 0;
      }
    }

    .animate-confetti-left {
      animation: confettiCannonLeft 3.2s cubic-bezier(0.15, 0.85, 0.35, 1) forwards;
    }

    .animate-confetti-right {
      animation: confettiCannonRight 3.2s cubic-bezier(0.15, 0.85, 0.35, 1) forwards;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-float, .animate-float-delayed, .animate-breathing, .animate-bounce {
        animation: none !important;
      }
      .confetti-piece {
        display: none !important;
      }
    }
